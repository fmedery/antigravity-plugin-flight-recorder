{
  "name": "flight-recorder",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Antigravity plugin to track and optimize parent-first plugin & skill spend, active time, prompt cache carry, and step-by-step timing across projects and chats.",
  "author": "Frederic Medery",
  "repository": {
    "type": "git",
    "url": "https://github.com/fmedery/antigravity-plugin-flight-recorder.git"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build:server": "tsc -p tsconfig.server.json --noEmit && node scripts/build-server.mjs",
    "build:ui": "vite build",
    "build": "npm run build:server && npm run build:ui",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "install-plugin": "node scripts/install-plugin.mjs",
    "version:check": "node scripts/check-version.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.0",
    "@types/node": ">=22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.2"
  }
}
