    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ./hooks/record_event.py",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ./hooks/record_event.py",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/record_event.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "python3 ./hooks/record_event.py",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ./hooks/record_event.py",
        "timeout": 5
      }
    ]
  }
}
